# Copy this file to deploy/demo/.env for local demo bootstrap.
# Do not commit deploy/demo/.env.

# Dify compose location inside WSL. Override this to your local Dify checkout.
NOVEL_AGENT_WSL_DISTRO=Ubuntu
NOVEL_AGENT_DIFY_COMPOSE_DIR=/home/<wsl-user>/dify/docker

# Optional out-of-band sanitized SQL backup directory.
# Expected files: manifest.json, dify.sql, dify_plugin.sql.
DIFY_SANITIZED_BACKUP_DIR=

# Dify Service API endpoint.
DIFY_BASE_URL=http://localhost/v1
DIFY_TIMEOUT_SECONDS=90

# Compose pack ports and optional smoke settings.
# Use *_HOST_PORT to avoid host port conflicts. Container ports stay fixed at backend 8000 and frontend 5173.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
BACKEND_BASE_IMAGE=mcr.microsoft.com/devcontainers/python:3.11-bookworm
FRONTEND_BASE_IMAGE=mcr.microsoft.com/devcontainers/javascript-node:22-bookworm
COMPOSE_DIFY_BASE_URL=http://host.docker.internal/v1
VITE_ALLOWED_HOSTS=frontend
DIFY_SMOKE_URL=
DIFY_SMOKE_REQUIRED=0

# Optional public-demo sandbox limits.
# Leave disabled for normal local development. Enable only when serving a bounded public experience.
PUBLIC_DEMO_MODE=0
PUBLIC_DEMO_TEMPLATE_BOOK_ID=
PUBLIC_DEMO_SESSION_TTL_SECONDS=600
PUBLIC_DEMO_IMPORT_CHAPTER_LIMIT=25
PUBLIC_DEMO_WORLD_INIT_LIMIT=1

# App keys. Prefer app-specific keys when available; keep this file blank.
DIFY_API_KEY=
DIFY_READING_ARCHIVE_API_KEY=
DIFY_WORLD_MODEL_API_KEY=
DIFY_STYLE_GUIDE_API_KEY=
DIFY_OUTLINE_API_KEY=
DIFY_CONTINUATION_API_KEY=
DIFY_REVIEW_API_KEY=

# Backend-owned world initialization needs a model API key when used.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
